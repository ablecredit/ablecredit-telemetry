# Copy the lines you need into your service's environment. Everything is optional:
# with no OTEL_EXPORTER_OTLP_ENDPOINT, telemetry is off and nothing is sent.

# Where SigNoz's collector listens for OTLP/HTTP (base URL, no /v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz.internal:4318
# How this service appears in SigNoz
OTEL_SERVICE_NAME=my-service
OTEL_SERVICE_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=staging

# Optional: extra export headers, e.g. an ingestion key for SigNoz Cloud
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=xxxx

# Kill switches (either one turns telemetry off even if an endpoint is set)
# OTEL_ENABLED=false
# OTEL_SDK_DISABLED=true
